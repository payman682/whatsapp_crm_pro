<odoo>
    <record id="view_whatsapp_crm_message_tree" model="ir.ui.view">
        <field name="name">whatsapp.crm.message.tree</field>
        <field name="model">whatsapp.crm.message</field>
        <field name="arch" type="xml">
            <list default_order="message_date desc">
                <field name="message_date"/>
                <field name="account_id"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="lead_id"/>
                <field name="direction"/>
                <field name="message_type"/>
                <field name="intent"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="message_status"/>
                <field name="body"/>
            </list>
        </field>
    </record>

    <record id="view_whatsapp_crm_message_form" model="ir.ui.view">
        <field name="name">whatsapp.crm.message.form</field>
        <field name="model">whatsapp.crm.message</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_lead" type="object" string="Open Lead" class="btn-primary" invisible="not lead_id"/>
                    <button name="action_reply_whatsapp" type="object" string="Reply" class="btn-secondary" invisible="not lead_id or direction == 'out'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_id"/>
                            <field name="lead_id"/>
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="message_date"/>
                            <field name="message_type"/>
                            <field name="intent"/>
                            <field name="priority"/>
                            <field name="state"/>
                            <field name="message_status"/>
                            <field name="replied_by_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="body"/>
                        <field name="summary"/>
                        <field name="raw_payload" readonly="1" widget="text"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_crm_messages" model="ir.actions.act_window">
        <field name="name">WhatsApp Messages</field>
        <field name="res_model">whatsapp.crm.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
