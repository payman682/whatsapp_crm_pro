<odoo>
    <record id="ir_cron_whatsapp_followup" model="ir.cron">
        <field name="name">WhatsApp CRM Follow-up</field>
        <field name="model_id" ref="model_whatsapp_crm_message"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_followups()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
