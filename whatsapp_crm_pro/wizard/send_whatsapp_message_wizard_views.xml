<odoo>
    <record id="view_send_whatsapp_message_wizard_form" model="ir.ui.view">
        <field name="name">send.whatsapp.message.wizard.form</field>
        <field name="model">send.whatsapp.message.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="lead_id" readonly="1"/>
                    <field name="account_id"/>
                    <field name="to_number" readonly="1"/>
                    <field name="body" placeholder="Type your WhatsApp reply..."/>
                </group>
                <footer>
                    <button name="action_use_suggested_reply" type="object" string="Use Suggested Reply" class="btn-secondary" invisible="not lead_id"/>
                    <button name="action_send" type="object" string="Send" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
